{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "types": ["./src/.d.ts"],

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": false,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@wailsjs/*": ["./wailsjs/*"],
            "@cmn/*": ["../../../packages/common/src/*"],
            "@repo/ui-next-preline/*": ["../../../packages/ui-next-preline/src/*"],
            "@repo/ui-next/*": ["../../../packages/ui-next/src/*"],
            "@repo/ui/*": ["../../../packages/ui/src/*"],
            "@mobile/ui-next/*": ["../../../mobile-apps/ui-next/src/*"],
        }
    },
    "include": [
        "src",
        "wailsjs/**/*.d.ts",
        "../../../packages/common/src/**/*.ts",
        "../../../packages/ui/src/**/*.ts",
        "../../../packages/ui-next-preline/src/**/*.ts",
        "../../../packages/ui-next-preline/src/**/*.tsx",
        "../../../packages/ui-next/src/**/*.ts",
        "../../../packages/ui-next/src/**/*.tsx",
        "../../../mobile-apps/ui-next/src/**/*.ts",
        "../../../mobile-apps/ui-next/src/**/*.tsx",
    ],
    "exclude": ["node_modules", "**/*/node_modules"]
    // "references": [{ "path": "./tsconfig.node.json" }]
}
